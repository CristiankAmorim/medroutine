<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MedRoutine" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primaria</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorPrimaryContainer">@color/primaria_clara</item>
        <item name="colorOnPrimaryContainer">@color/primaria_escura</item>
        <item name="colorSecondary">@color/confirmacao</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="colorSecondaryContainer">@color/confirmacao_fundo</item>
        <item name="colorOnSecondaryContainer">@color/confirmacao</item>
        <item name="colorError">@color/alerta</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/borda</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/primaria</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="materialButtonStyle">@style/Widget.MedRoutine.Botao</item>
        <item name="textInputStyle">@style/Widget.MedRoutine.Campo</item>
        <item name="materialCardViewStyle">@style/Widget.MedRoutine.Cartao</item>
        <item name="toolbarStyle">@style/Widget.MedRoutine.Toolbar</item>
    </style>

    <style name="Theme.MedRoutine.Lembrete" parent="Theme.MedRoutine">
        <item name="android:windowBackground">@color/primaria</item>
        <item name="android:statusBarColor">@color/primaria</item>
    </style>

    <style name="Theme.MedRoutine.Splash" parent="Theme.MedRoutine">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="Widget.MedRoutine.Botao" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:minHeight">@dimen/botao_altura</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.MedRoutine.Botao.Contorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:minHeight">@dimen/botao_altura</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/primaria</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.MedRoutine.Botao.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:minHeight">@dimen/toque_minimo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.MedRoutine.Botao.Alerta" parent="Widget.MedRoutine.Botao">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="backgroundTint">@color/alerta</item>
    </style>

    <style name="Widget.MedRoutine.Botao.Confirmar" parent="Widget.MedRoutine.Botao">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="backgroundTint">@color/confirmacao</item>
    </style>

    <style name="Widget.MedRoutine.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.MedRoutine.Cartao" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/raio_cartao</item>
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="Widget.MedRoutine.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/superficie</item>
        <item name="titleTextColor">@color/texto</item>
    </style>

    <style name="Texto.Titulo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="Texto.Corpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="Texto.Secundario" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:textSize">@dimen/texto_pequeno</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Texto.Secao" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
</resources>
