<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/texto_explicacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Texto.Corpo" />

    <TextView
        android:id="@+id/texto_codigo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/fundo_selo"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:padding="16dp"
        android:textColor="@color/primaria"
        android:textIsSelectable="true"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/texto_validade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/Texto.Secundario" />
</LinearLayout>
