<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/voltar"
        app:navigationIcon="@drawable/ic_voltar"
        app:subtitleTextColor="@color/texto_secundario"
        app:title="@string/novo_medicamento" />

    <include layout="@layout/include_faixa_demo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nome_medicamento">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entrada_nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="120"
                    android:textSize="@dimen/texto_corpo" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_dosagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/dosagem"
                app:placeholderText="@string/dosagem_exemplo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entrada_dosagem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="60"
                    android:textSize="@dimen/texto_corpo" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_orientacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/orientacoes_opcional"
                app:counterEnabled="true"
                app:counterMaxLength="500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entrada_orientacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="500"
                    android:minLines="2"
                    android:textSize="@dimen/texto_corpo" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/frequencia"
                android:textAppearance="@style/Texto.Secao" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupo_frequencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_freq_fixos"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/toque_minimo"
                    android:paddingHorizontal="4dp"
                    android:text="@string/freq_fixos"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_freq_intervalo"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/toque_minimo"
                    android:paddingHorizontal="4dp"
                    android:text="@string/freq_intervalo"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botao_freq_dias"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/toque_minimo"
                    android:paddingHorizontal="4dp"
                    android:text="@string/freq_dias"
                    android:textSize="13sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campo_intervalo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/intervalo_horas"
                android:visibility="gone"
                app:helperText="@string/intervalo_ajuda">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entrada_intervalo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textSize="@dimen/texto_corpo" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/grupo_dias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quais_dias"
                    android:textAppearance="@style/Texto.Secundario" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chips_dias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_dom"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/toque_minimo"
                        android:text="@string/dia_dom" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_seg"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/toque_minimo"
                        android:text="@string/dia_seg" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_ter"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/toque_minimo"
                        android:text="@string/dia_ter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_qua"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/toque_minimo"
                        android:text="@string/dia_qua" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_qui"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/toque_minimo"
                        android:text="@string/dia_qui" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sex"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/toque_minimo"
                        android:text="@string/dia_sex" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_sab"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/toque_minimo"
                        android:text="@string/dia_sab" />

                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <TextView
                android:id="@+id/titulo_horarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/horarios"
                android:textAppearance="@style/Texto.Secao" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_horarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_add_horario"
                style="@style/Widget.MedRoutine.Botao.Contorno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/adicionar_horario"
                app:icon="@drawable/ic_adicionar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/tolerancia_confirmar"
                android:textAppearance="@style/Texto.Secao" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_tolerancia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tol_15"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/toque_minimo"
                    android:text="@string/tol_15" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tol_30"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="@dimen/toque_minimo"
                    android:text="@string/tol_30" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tol_60"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/toque_minimo"
                    android:text="@string/tol_60" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tol_outro"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/toque_minimo"
                    android:text="@string/tol_outro" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/texto_tolerancia_ajuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tolerancia_ajuda"
                android:textAppearance="@style/Texto.Secundario" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campo_inicio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/inicio">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/entrada_inicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:textSize="@dimen/texto_corpo" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campo_fim"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/termino_opcional"
                    app:endIconContentDescription="@string/limpar_termino"
                    app:endIconDrawable="@drawable/ic_fechar"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/entrada_fim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:textSize="@dimen/texto_corpo" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:orientation="vertical"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/progresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_salvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/salvar_medicamento" />
    </LinearLayout>
</LinearLayout>
