<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aviso_permissoes"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margem_tela"
    android:layout_marginTop="12dp"
    android:background="@drawable/fundo_aviso"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alerta"
            app:tint="@color/alerta" />

        <TextView
            android:id="@+id/texto_aviso_permissao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/alerta_texto"
            android:textSize="@dimen/texto_corpo" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botao_aviso_permissao"
        style="@style/Widget.MedRoutine.Botao.Alerta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="@string/ativar" />
</LinearLayout>
