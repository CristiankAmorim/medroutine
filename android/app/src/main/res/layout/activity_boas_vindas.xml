<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/fundo_logo"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_marca"
                app:tint="@color/destaque" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/primaria"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/slogan"
            android:textAppearance="@style/Texto.Corpo"
            android:textColor="@color/texto_secundario" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_cuidador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sou_cuidador" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_idoso"
            style="@style/Widget.MedRoutine.Botao.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sou_idoso" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_demo"
            style="@style/Widget.MedRoutine.Botao.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/conhecer_demo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_servidor"
            style="@style/Widget.MedRoutine.Botao.Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configurar_servidor"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
